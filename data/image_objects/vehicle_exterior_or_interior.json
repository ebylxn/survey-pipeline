{
  "version": 1,
  "id": "vehicle_exterior_or_interior",
  "label": "Phương tiện (thân xe, đầu xe, vô lăng)",
  "description": "Ảnh chụp phương tiện thực tế: thân xe, đầu xe hoặc vô lăng khoang lái",
  "prompt": "Analyze the vehicle photo. Detect: {{objects}}. Expected fields: {{fields}}. Configuration: {{config}}. Extract vehicle_type (CAR/BIKE), view (EXTERIOR/COCKPIT/STEERING_WHEEL/ODOMETER), license_plate (verbatim or null) and is_authentic (false for stock/mockup images). Output JSON only.",
  "objects": [
    "vehicle body",
    "front of vehicle",
    "steering wheel or cockpit"
  ],
  "expected_fields": [
    {"key": "vehicle_type", "label": "Loại phương tiện", "type": "string", "required": false},
    {"key": "view", "label": "Góc chụp", "type": "string", "required": true},
    {"key": "license_plate", "label": "Biển số", "type": "string", "required": false},
    {"key": "is_authentic", "label": "Ảnh thật", "type": "boolean", "required": true}
  ],
  "customizable": [
    {"key": "require_plate", "label": "Bắt buộc biển số", "type": "toggle", "default": false},
    {"key": "allowed_views", "label": "Góc chụp cho phép (dấu phẩy)", "type": "text", "default": "EXTERIOR,COCKPIT,STEERING_WHEEL,ODOMETER"}
  ],
  "engines": [
    {
      "id": "vehicle_plate_required",
      "label": "Bắt buộc biển số",
      "params": {"fields": ["license_plate"]},
      "conditions": [{"field": "$config.require_plate", "op": "equals", "value": true}]
    },
    {
      "id": "vehicle_view_allowed",
      "label": "Góc chụp hợp lệ",
      "params": {
        "field": "view",
        "allowed": "{{allowed_views}}",
        "message": "Góc chụp phương tiện không nằm trong danh sách cho phép."
      },
      "conditions": [{"field": "view", "op": "not_empty"}]
    },
    {
      "id": "vehicle_authentic",
      "label": "Ảnh phương tiện thật",
      "params": {
        "field": "is_authentic",
        "expected": true,
        "message": "Không phát hiện ảnh phương tiện thật."
      },
      "conditions": [{"field": "is_authentic", "op": "not_empty"}]
    }
  ],
  "extractor": "vehicle",
  "classify_role": "vehicle_exterior"
}
